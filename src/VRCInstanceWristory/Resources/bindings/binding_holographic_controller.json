{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "vrcinstancewristory.overlay",
  "bindings": {
    "/actions/main": {
      "poses": [
        {
          "output": "/actions/main/in/right_aim",
          "path": "/user/hand/right/pose/tip"
        },
        {
          "output": "/actions/main/in/left_aim",
          "path": "/user/hand/left/pose/tip"
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/right/output/haptic"
        },
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/left/output/haptic"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/scroll"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/click"
            }
          }
        },
        {
          "path": "/user/hand/left/input/menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/close_panel"
            }
          }
        },
        {
          "path": "/user/hand/right/input/menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/close_panel"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/scroll"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/click"
            }
          }
        }
      ]
    }
  },
  "controller_type": "holographic_controller",
  "description": "VRC Instance Wristory default bindings (Windows Mixed Reality)",
  "name": "VRC Instance Wristory default bindings (Windows Mixed Reality)",
  "category": "steamvr_input"
}

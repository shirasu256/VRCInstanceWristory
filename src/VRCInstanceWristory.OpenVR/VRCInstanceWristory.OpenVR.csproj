<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Valve OpenVR SDK の公式C#バインディングだけを収めた薄いプロジェクト。
    third_party/openvr/openvr_api.cs は無編集で取り込む。自動生成コードの警告は
    このプロジェクト内に閉じ込め、アプリ側の警告設定を緩めない。
    固定した版: OpenVR SDK v2.15.6 (commit 0924064316de3effbcd1acf1e309182a2deb1c05)
  -->

  <PropertyGroup>
    <TargetFramework>$(LibTargetFramework)</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8500;SYSLIB1054</NoWarn>
    <!-- 無編集で取り込んだ自動生成のコードなので、ドキュメントコメントは検査しない。 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>VRCInstanceWristory.OpenVR</AssemblyName>
    <RootNamespace>Valve.VR</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\third_party\openvr\openvr_api.cs" Link="openvr_api.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ネイティブDLLは実行フォルダーへ配置する。 -->
    <None Include="..\..\third_party\openvr\bin\win64\openvr_api.dll" Link="openvr_api.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
